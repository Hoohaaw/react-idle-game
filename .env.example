# Copy to .env.local and fill in.
# Local dev: run `npx supabase start` and use the printed Project URL + Publishable key.
# Production: use the hosted Supabase project's URL + publishable (anon) key.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Sanity Viewer (read) token — required to read DRAFT content (unpublished characters) while authoring.
# Create one at manage.sanity.io (project q6f4y8es, role: Viewer). Drop it once content is published.
VITE_SANITY_READ_TOKEN=
